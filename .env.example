# Copie para .env (fora do git) e ajuste.
POSTGRES_PASSWORD=troque-dono
NEXO_APP_SENHA=troque-app

# Serviço de processamento: falso | openai
MODELO_EMBEDDING_PROVEDOR=falso
MODELO_LINGUAGEM_PROVEDOR=falso
OPENAI_API_KEY=

# GEMINI (Google AI Studio): alternativa com nível gratuito. Crie a chave em https://aistudio.google.com/apikey
# Exemplo, tudo no Gemini gratuito (use só material seu: no nível gratuito o Google pode usar o conteúdo para melhorar produtos):
#   MODELO_LINGUAGEM_PROVEDOR=gemini      MODELO_EMBEDDING_PROVEDOR=gemini
#   GEMINI_API_KEY=...
#   MODELO_LINGUAGEM_NOME=gemini-3.1-flash-lite      (ou gemini-3.5-flash-lite; confira os modelos liberados no AI Studio)
#   MODELO_EMBEDDING_NOME=gemini-embedding-2         (vazio também vale; alternativas: gemini-embedding-001, gemini-embedding-2-preview)
#   PRECO_LINGUAGEM_ENTRADA_USD_POR_MILHAO=0   PRECO_LINGUAGEM_SAIDA_USD_POR_MILHAO=0   PRECO_EMBEDDING_USD_POR_MILHAO=0
# Os dois provedores são independentes (dá para usar o Gemini num e a OpenAI no outro). Trocar o embedding exige reindexar tudo.
GEMINI_API_KEY=

# Embedding REAL (MODELO_EMBEDDING_PROVEDOR=openai). O padrão é o text-embedding-3-small (preço já conhecido pela aplicação). Para usar o text-embedding-3-large:
#   MODELO_EMBEDDING_NOME=text-embedding-3-large
#   PRECO_EMBEDDING_USD_POR_MILHAO=<valor da página de preços; sem ele o modelo é recusado>
# A dimensão continua 1536 (a coluna do banco): a API reduz o vetor do 3-large com o parâmetro `dimensions`. Trocar de modelo depois de ter materiais
# indexados exige reindexar tudo (os vetores de modelos diferentes não se comparam): em desenvolvimento, `docker compose down -v` e envie de novo.
MODELO_EMBEDDING_NOME=
PRECO_EMBEDDING_USD_POR_MILHAO=

# Modelo de linguagem REAL (MODELO_LINGUAGEM_PROVEDOR=openai): nome exato do modelo e preços em US$ por milhão de tokens, do painel do provedor
# (platform.openai.com: Settings > Limits mostra os modelos e os limites da sua conta; a página de preços traz os valores). Sem os dois preços a
# aplicação RECUSA operações com o modelo real, porque o limite de gasto (US$ 10 por 30 dias) precisa do custo.
# Teste em conta gratuita: use 0 e 0 (o limite de gasto não age, mas também não há cobrança).
MODELO_LINGUAGEM_NOME=
PRECO_LINGUAGEM_ENTRADA_USD_POR_MILHAO=
PRECO_LINGUAGEM_SAIDA_USD_POR_MILHAO=
# Teto de tokens de cada resposta (modelos de raciocínio gastam tokens pensando: aumente se a resposta vier cortada).
MODELO_LINGUAGEM_MAX_TOKENS=4096
# Temperatura do modelo de linguagem (vazio = não enviar). Valores baixos (0.2) deixam o JSON dos modelos pequenos mais estável; modelos de
# raciocínio (gpt-5*, o3, o4) recusam valor fora do padrão: deixe vazio neles.
MODELO_LINGUAGEM_TEMPERATURA=

# Segredo compartilhado entre o backend e o serviço de processamento (rede interna do compose).
NEXO_PROCESSAMENTO_SEGREDO=troque-por-outro-segredo-interno-longo

NEXO_JWT_SEGREDO=troque-por-um-segredo-com-32-caracteres-ou-mais

# desenvolvimento | producao. Em producao a aplicação recusa subir com e-mail falso, cookie sem Secure ou URL sem https.
NEXO_AMBIENTE=desenvolvimento
